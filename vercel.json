{
  "functions": {
    "api/student-page.js": {
      "includeFiles": "student.html"
    }
  },
  "routes": [
    {
      "src": "/student.html",
      "has": [
        {
          "type": "query",
          "key": "cat",
          "value": "(?<cat>.*)"
        }
      ],
      "dest": "/api/student-page?cat=$cat"
    }
  ]
}
